{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bikerlink-website-gate1-staging",
  "main": "src/worker.js",
  "account_id": "d116d3d97b133c543d02934be4bc98d2",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "vars": {
    "RAILWAY_ORIGIN": "https://bikerlink-staging-staging.up.railway.app",
    "PUBLIC_SITE_ORIGIN": "https://biker-link.net",
    "GATE1_STAGING_ORIGIN_OVERRIDE": "https://bikerlink-staging-staging.up.railway.app"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "SITE_ASSETS",
      "bucket_name": "bikerlink-website-assets"
    }
  ]
}
