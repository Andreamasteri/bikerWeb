{
  "name": "bikerlink-website-production",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "vars": {
    "RAILWAY_ORIGIN": "https://bikerlink-production.up.railway.app",
    "PUBLIC_SITE_ORIGIN": "https://biker-link.net"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "SITE_ASSETS",
      "bucket_name": "bikerlink-website-assets"
    }
  ],
  "previews": {
    "vars": {
      "RAILWAY_ORIGIN": "https://bikerlink-production.up.railway.app",
      "PUBLIC_SITE_ORIGIN": "https://biker-link.net"
    },
    "r2_buckets": [
      {
        "binding": "SITE_ASSETS",
        "bucket_name": "bikerlink-website-assets"
      }
    ]
  }
}
